#!/bin/bash

# FactoryProxy CLI Tool
# Provides command-line access to FactoryProxy features like aliases and templates

set -e

CONFIG_DIR="$HOME/.cli-proxy-api"
ALIASES_FILE="$CONFIG_DIR/aliases.json"
TEMPLATES_FILE="$CONFIG_DIR/templates.json"

# Create config directory if it doesn't exist
mkdir -p "$CONFIG_DIR"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_error() {
    echo -e "${RED}Error: $1${NC}" >&2
}

log_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

log_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

# Alias commands
alias_list() {
    if [ ! -f "$ALIASES_FILE" ]; then
        log_info "No aliases found"
        return
    fi

    echo -e "${BLUE}Model Aliases:${NC}"
    python3 -m json.tool "$ALIASES_FILE" 2>/dev/null | grep -A1 '"alias"' | head -20 || log_error "Failed to parse aliases file"
}

alias_add() {
    local alias_name="$1"
    local model_name="$2"

    if [ -z "$alias_name" ] || [ -z "$model_name" ]; then
        log_error "Usage: factory-proxy alias add <alias> <model>"
        echo "Example: factory-proxy alias add fast gpt-5"
        return 1
    fi

    # For now, provide instructions since the main app handles persistence
    log_info "To add an alias, use the FactoryProxy app:"
    echo "1. Open FactoryProxy settings"
    echo "2. Go to the 'Aliases' tab"
    echo "3. Click 'Add' and enter:"
    echo "   - Alias: $alias_name"
    echo "   - Model: $model_name"
}

alias_delete() {
    local alias_name="$1"

    if [ -z "$alias_name" ]; then
        log_error "Usage: factory-proxy alias delete <alias>"
        return 1
    fi

    log_info "To delete an alias, use the FactoryProxy app:"
    echo "1. Open FactoryProxy settings"
    echo "2. Go to the 'Aliases' tab"
    echo "3. Find '$alias_name' and click the trash icon"
}

# Template commands
template_list() {
    if [ ! -f "$TEMPLATES_FILE" ]; then
        log_info "No templates found"
        return
    fi

    echo -e "${BLUE}Prompt Templates:${NC}"
    python3 -m json.tool "$TEMPLATES_FILE" 2>/dev/null | grep '"name"' | head -20 || log_error "Failed to parse templates file"
}

template_show() {
    local template_name="$1"

    if [ -z "$template_name" ]; then
        log_error "Usage: factory-proxy template show <name>"
        return 1
    fi

    if [ ! -f "$TEMPLATES_FILE" ]; then
        log_error "No templates found"
        return 1
    fi

    python3 -c "
import json
import sys

with open('$TEMPLATES_FILE') as f:
    templates = json.load(f)

for t in templates:
    if t['name'] == '$template_name':
        print(f\"Template: {t['name']}\")
        print(f\"Description: {t.get('description', 'N/A')}\")
        print(f\"\\nPrompt:\\n{t['promptText']}\")
        if t.get('systemPrompt'):
            print(f\"\\nSystem Prompt:\\n{t['systemPrompt']}\")
        sys.exit(0)

print('Template not found: $template_name')
sys.exit(1)
" || log_error "Failed to find template"
}

# Server status
server_status() {
    if lsof -Pi :8317 -sTCP:LISTEN -t >/dev/null 2>&1; then
        log_success "FactoryProxy server is running (port 8317)"
        echo "Connect at: http://localhost:8317"
    else
        log_error "FactoryProxy server is not running"
        echo "To start: Open the FactoryProxy app from Applications"
        return 1
    fi
}

# Help
show_help() {
    cat << EOF
${BLUE}FactoryProxy CLI${NC}

Usage: factory-proxy <command> [options]

${BLUE}Commands:${NC}

  ${YELLOW}Server${NC}
    status              Check if FactoryProxy server is running

  ${YELLOW}Aliases${NC}
    alias list          List all model aliases
    alias add <alias> <model>    Add a new alias
    alias delete <alias>         Delete an alias

  ${YELLOW}Templates${NC}
    template list       List all prompt templates
    template show <name>         Show a specific template

  ${YELLOW}Other${NC}
    --version          Show version
    --help             Show this help message

${BLUE}Examples:${NC}
  factory-proxy status
  factory-proxy alias list
  factory-proxy template show "Code Review"

${BLUE}Note:${NC} Most operations require the FactoryProxy app to be running.
For full management, open the FactoryProxy settings window.
EOF
}

# Main logic
case "${1:-help}" in
    alias)
        case "${2:-list}" in
            list) alias_list ;;
            add) alias_add "$3" "$4" ;;
            delete) alias_delete "$3" ;;
            *) log_error "Unknown alias subcommand: $2"; show_help; exit 1 ;;
        esac
        ;;
    template)
        case "${2:-list}" in
            list) template_list ;;
            show) template_show "$3" ;;
            *) log_error "Unknown template subcommand: $2"; show_help; exit 1 ;;
        esac
        ;;
    status)
        server_status
        ;;
    --version)
        echo "FactoryProxy CLI v1.0"
        ;;
    --help|help|"")
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
