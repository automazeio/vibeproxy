<Window x:Class="VibeProxy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeProxy Settings"
        Width="520"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="480"
        MinHeight="500"
        Background="#1E1E1E"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/glyph.png">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4B5563"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServiceRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Header -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="VibeProxy"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Extended thinking proxy for AI coding assistants"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Server Status Section -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Server Status" Style="{StaticResource HeaderStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="StatusIndicator"
                                     Width="12" Height="12"
                                     Margin="0,0,8,0"
                                     Fill="#EF4444"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Stopped"
                                       Foreground="#E0E0E0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ToggleServerButton"
                                    Content="Start Server"
                                    Style="{StaticResource ActionButton}"
                                    Click="ToggleServer_Click"
                                    Margin="0,0,8,0"/>

                            <Button Content="Open Auth Folder"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OpenAuthFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connected Services Section -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Connected Services" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Connect to AI provider services using OAuth"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,0,0,12"/>

                        <StackPanel x:Name="ServicesPanel">
                            <!-- Service rows will be added programmatically -->
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Logs Section -->
                <Border Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Server Logs"
                                   Style="{StaticResource HeaderStyle}"/>

                        <Border Grid.Row="1"
                                Background="#1E1E1E"
                                CornerRadius="4"
                                Padding="8">
                            <ScrollViewer x:Name="LogScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogTextBlock"
                                           Text="No logs yet..."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#9CA3AF"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- Settings Section -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource HeaderStyle}"/>

                        <CheckBox x:Name="LaunchAtLoginCheckBox"
                                  Content="Launch at login"
                                  Foreground="#E0E0E0"
                                  Checked="LaunchAtLogin_Changed"
                                  Unchecked="LaunchAtLogin_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <TextBlock Foreground="#6B7280"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,8,0,0">
                    <Run Text="VibeProxy v1.0.0 | Ported by Daute Delgado | "/>
                    <Hyperlink NavigateUri="https://github.com/automazeio/vibeproxy"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="#3B82F6">
                        GitHub
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
